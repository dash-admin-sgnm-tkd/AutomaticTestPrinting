<Window x:Class="AutomaticTestPrinting.App.PdfMaterialRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF教材を登録" Width="1060" Height="720" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F2F4F7" Closing="Window_Closing">
    <Grid x:Name="EditorGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="PDF教材を登録" />
            <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                       Text="レポートの教材名と問題番号を、元PDFに対応づけます。教材PDFは先にメイン画面の教材フォルダー内に置いてください。" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="ProfilesComboBox" Width="360" DisplayMemberPath="DisplayName" SelectionChanged="Profile_Changed" />
                <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="New_Click" Content="新規登録" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="教材名（レポートに書かれる名前）" />
                <TextBox x:Name="NameTextBox" Padding="8,6" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="別名（任意・カンマ区切り）" />
                <TextBox x:Name="AliasesTextBox" Padding="8,6" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" Text="問題番号はレポートの範囲に対応する番号です。PDFページはビューアー上の番号（例：1-3,5）。空欄＝全ページ。分割PDFの番号は仮に連番を付けるので、必ず確認・修正してください。" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource SecondaryButton}" Click="Add_Click" Content="問題PDFを追加" />
                <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="Duplicate_Click" Content="同じPDFで行を追加" />
                <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="Answer_Click" Content="選択行に解答PDFを設定" />
                <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="Remove_Click" Content="選択行を外す" />
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="MappingGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" RowHeight="36" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="問題番号" Width="85" Binding="{Binding Number}" />
                <DataGridTextColumn Header="問題PDFのファイル名" Width="*" Binding="{Binding FileName}" />
                <DataGridTextColumn Header="問題ページ" Width="120" Binding="{Binding Pages}" />
                <DataGridTextColumn Header="解答PDF（任意）" Width="*" Binding="{Binding AnswerFileName}" />
                <DataGridTextColumn Header="解答ページ" Width="120" Binding="{Binding AnswerPages}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,12,0,12">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                       Text="範囲内から指定問題数を抽選します。解答は全問登録するか全問空欄にしてください。教材名・別名は空白や括弧等を除いて完全一致で照合します。" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <Button x:Name="SaveButton" Grid.Row="5" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                Click="Save_Click" Content="対応表を確認して保存" />
    </Grid>
</Window>
