<Window x:Class="AutomaticTestPrinting.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="確認テスト作成"
        Width="1100" Height="760" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F2F4F7"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#EAECF0" BorderThickness="0,0,0,1">
            <Grid Margin="36,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="Bold" Text="確認テスト作成" />
                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}"
                               Text="レポートを読み込み、内容を確認してからテストを作成します。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,12,0" Style="{StaticResource SecondaryButton}"
                            Click="RegisterMaterial_Click" Content="教材を登録" />
                    <Border VerticalAlignment="Center" Background="#ECFDF3"
                            BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="12" Padding="12,5">
                        <TextBlock Foreground="#067647" FontWeight="SemiBold" Text="初期設定" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,28,36,24">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="26">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="1. フォルダーを設定" />
                        <TextBlock Margin="0,6,0,20" Foreground="{StaticResource MutedTextBrush}"
                                   Text="Google Driveのレポート受け取り先、教材、作成結果の保存先を指定してください。" />
                        <TextBlock FontWeight="SemiBold" Text="レポート受け取りフォルダー（Google Drive）" />
                        <Grid Margin="0,8,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ReportInboxFolderTextBox" Height="40" Padding="10,8"
                                     VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}"
                                     IsReadOnly="True" ToolTip="Google Driveでミラーリングした未処理レポートフォルダー" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                                    Click="BrowseReportInboxFolder_Click" Content="フォルダーを選択" />
                        </Grid>
                        <TextBlock FontWeight="SemiBold" Text="教材フォルダー" />
                        <Grid Margin="0,8,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MaterialFolderTextBox" Height="40" Padding="10,8"
                                     VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}"
                                     IsReadOnly="True" ToolTip="ExcelとPDF教材を保存しているOneDriveフォルダー" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                                    Click="BrowseMaterialFolder_Click" Content="フォルダーを選択" />
                        </Grid>
                        <TextBlock FontWeight="SemiBold" Text="出力フォルダー" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputFolderTextBox" Height="40" Padding="10,8"
                                     VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderBrush}"
                                     IsReadOnly="True" ToolTip="作成した問題PDFと解答PDFの保存先" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                                    Click="BrowseOutputFolder_Click" Content="フォルダーを選択" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,20,0,0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="2. レポートを選択" />
                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"
                                           Text="PDFは複数選択できます。手書き部分は読み取り対象にしません。" />
                            </StackPanel>
                            <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButton}" Click="LoadInboxReports_Click"
                                    Content="Google Driveから読込" />
                            <Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Click="AddReports_Click" Content="PDFを追加" />
                            <Button Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Click="ClearReports_Click" Content="すべて外す" />
                        </Grid>

                        <Border Grid.Row="1" Margin="0,20,0,0" Background="#F9FAFB"
                                BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <TextBlock x:Name="EmptyReportsText" Padding="18,24" HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" Text="まだレポートが選択されていません" />
                                <ListBox x:Name="ReportsList" Margin="8" MinHeight="100" MaxHeight="190"
                                         Background="Transparent" BorderThickness="0" ItemsSource="{Binding Reports}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" Background="#FEE4E2" CornerRadius="6">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#B42318" FontWeight="Bold" Text="PDF" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="RecognitionResultsSection" Margin="0,20,0,0"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="26">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="3. 読み取り結果を確認" />
                            <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}"
                                    Click="SkipInvalidRequests_Click" Content="エラー・未対応を一括スキップ" />
                            <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                    Click="RestoreAllRequests_Click" Content="全件を対象に戻す" />
                            <Button x:Name="AttentionFilterButton" Grid.Column="3" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="AttentionFilterButton_Click" Content="要確認だけ表示" />
                            <Button x:Name="SaveSkippedLogButton" Grid.Column="4" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}" IsEnabled="False"
                                    Click="SaveSkippedLogButton_Click" Content="スキップ一覧を保存" />
                        </Grid>
                        <TextBlock Margin="0,6,0,18" Foreground="{StaticResource MutedTextBrush}"
                                   Text="原本と比べ、誤りがあれば入力欄を修正してください。修正後は自動で再検査します。" />
                        <ItemsControl ItemsSource="{Binding RecognitionResultsView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="16" Background="#F9FAFB"
                                            BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox Margin="0,0,12,10" FontWeight="SemiBold"
                                                          IsChecked="{Binding IsIncluded}"
                                                          Content="このレポートを処理対象にする" />
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="生徒名" />
                                                <TextBox Margin="0,5,12,0" Padding="8,6" FontSize="15" FontWeight="SemiBold"
                                                         IsEnabled="{Binding IsIncluded}"
                                                         Text="{Binding StudentName, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Margin="0,5,12,0" FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding FileName}" TextWrapping="Wrap" />
                                                <Button Margin="0,10,12,0" HorizontalAlignment="Left"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Tag="{Binding SourcePath}" Click="OpenSourceReport_Click"
                                                        Content="原本PDFを開く" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding NormalTestSummary}" />
                                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Requests}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,10" Padding="12" Background="White"
                                                                    BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="7">
                                                                <StackPanel>
                                                                    <CheckBox FontWeight="SemiBold" IsChecked="{Binding IsIncluded}">
                                                                        <TextBlock>
                                                                            <Run Text="テスト " /><Run Text="{Binding DisplayNumber}" />
                                                                            <Run Text=" を作成する" />
                                                                        </TextBlock>
                                                                    </CheckBox>
                                                                    <Grid Margin="0,8,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="10" />
                                                                            <ColumnDefinition Width="90" />
                                                                            <ColumnDefinition Width="10" />
                                                                            <ColumnDefinition Width="90" />
                                                                            <ColumnDefinition Width="10" />
                                                                            <ColumnDefinition Width="80" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock FontSize="12" Text="教材名" />
                                                                            <TextBox Margin="0,4,0,0" Padding="8,6" IsEnabled="{Binding IsIncluded}"
                                                                                     Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                            <TextBlock FontSize="12" Text="開始番号" />
                                                                            <TextBox Margin="0,4,0,0" Padding="8,6" IsEnabled="{Binding IsIncluded}"
                                                                                     Text="{Binding StartNumber, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="4">
                                                                            <TextBlock FontSize="12" Text="終了番号" />
                                                                            <TextBox Margin="0,4,0,0" Padding="8,6" IsEnabled="{Binding IsIncluded}"
                                                                                     Text="{Binding EndNumber, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="6">
                                                                            <TextBlock FontSize="12" Text="問題数" />
                                                                            <TextBox Margin="0,4,0,0" Padding="8,6" IsEnabled="{Binding IsIncluded}"
                                                                                     Text="{Binding QuestionCount, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold"
                                                                               Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#B42318" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#067647" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Margin="0,5,0,0" Text="{Binding StageTestSummary}" />
                                                <TextBlock Margin="0,7,0,0" FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding OrientationSummary}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#EAECF0" BorderThickness="0,1,0,0">
            <Grid Margin="36,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" Text="設定を確認してください" />
                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               Text="確認後にPDFを作成できます。プリンターへの印刷は行いません。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ConfirmResultsCheckBox" Margin="0,0,14,0"
                              VerticalAlignment="Center"
                              Checked="ConfirmResultsCheckBox_Changed"
                              Unchecked="ConfirmResultsCheckBox_Changed"
                              Content="原本と読み取り結果を確認しました" />
                    <Button x:Name="ValidateButton" MinWidth="170"
                            Style="{StaticResource SecondaryButton}" Click="ValidateButton_Click"
                            Content="レポートを読み取る" />
                    <Button x:Name="CreatePdfsButton" Margin="10,0,0,0" MinWidth="190"
                            Style="{StaticResource PrimaryButton}" Click="CreatePdfsButton_Click"
                            IsEnabled="False" Content="問題・解答PDFを作成" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
