<Window x:Class="AutomaticTestPrinting.App.BulkMaterialRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="教材をまとめて登録"
        Width="1380" Height="760" MinWidth="1080" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F2F4F7"
        ShowInTaskbar="False" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#EAECF0" BorderThickness="0,0,0,1" Padding="30,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="23" FontWeight="Bold" Text="教材をまとめて登録" />
                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}"
                               Text="登録した教材フォルダーすべてのExcelを自動判定します。登録する教材だけチェックしてください。" />
                </StackPanel>
                <Button x:Name="RescanButton" Grid.Column="1" VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}" Click="Rescan_Click"
                        Content="もう一度スキャン" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Padding="16" Background="#EFF8FF" BorderBrush="#B2DDFF"
                    BorderThickness="1" CornerRadius="8">
                <TextBlock x:Name="ScanSummaryText" Foreground="#175CD3" TextWrapping="Wrap"
                           Text="教材フォルダーをまとめて確認しています…" />
            </Border>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" Text="教材を検索" />
                <TextBox x:Name="SearchTextBox" Grid.Column="1" Padding="11,8" FontSize="14"
                         TextChanged="SearchTextBox_TextChanged"
                         ToolTip="教材名・Excelファイル名・形式で検索"
                         AutomationProperties.Name="教材を検索" />
                <Button Grid.Column="2" Margin="10,0,0,0" Padding="14,7"
                        Style="{StaticResource SecondaryButton}" Click="ClearSearch_Click"
                        Content="検索をクリア" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="700" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="CandidatesGrid"
                          ItemsSource="{Binding CandidatesView}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0" AlternatingRowBackground="#F9FAFB"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="登録" Width="58"
                                                Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn Header="Excelファイル" Width="2.1*" IsReadOnly="True"
                                            Binding="{Binding WorkbookFileName}" />
                        <DataGridTemplateColumn Header="教材名" Width="1.7*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Margin="4" Padding="7,5"
                                             IsEnabled="{Binding CanRegister}"
                                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="完成形式" Width="1.65*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="4" Padding="6,4"
                                              IsEnabled="{Binding CanRegister}"
                                              ItemsSource="{Binding MatchingFormats}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedFormat, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="最大番号" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Margin="4" Padding="7,5" HorizontalContentAlignment="Right"
                                             IsEnabled="{Binding CanRegister}"
                                             Text="{Binding MaximumQuestionNumber, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="判定結果" Width="1.4*" IsReadOnly="True"
                                            Binding="{Binding Message}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="1" Margin="18,0,0,0" Padding="18"
                        Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="9"
                        DataContext="{Binding ElementName=CandidatesGrid, Path=SelectedItem.SelectedFormat}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Text="完成形式のプレビュー" />
                        <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#175CD3" Text="{Binding DisplayName, TargetNullValue=教材を選択してください}" />
                        <TextBlock Margin="0,5,0,14" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" Text="{Binding PreviewDescription}" />

                        <Border Padding="14" Background="#F8FAFC" BorderBrush="#D0D5DD"
                                BorderThickness="1" CornerRadius="5">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="確認テスト（見本）" />
                                <Border Margin="0,12,0,0" Padding="10" Background="White"
                                        BorderBrush="#98A2B3" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#475467" Text="問題" />
                                        <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                                                   LineHeight="20" Text="{Binding PreviewQuestion}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,10,0,0" Padding="10" Background="#EFF8FF"
                                        BorderBrush="#84CAFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#175CD3" Text="解答" />
                                        <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                                                   LineHeight="20" Text="{Binding PreviewAnswer}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="#667085"
                                   TextWrapping="Wrap"
                                   Text="※ 内容は形式を見分けるための見本です。実際の問題文や装飾は教材によって異なります。" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Grid.Row="3" Margin="0,12,0,0" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                       Text="形式が不明な教材は登録されません。「完成形式」は右の見本を見ながら選べます。教材名はレポートに書かれる名前へ修正できます。" />
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#EAECF0" BorderThickness="0,1,0,0">
            <Grid Margin="30,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RegistrationStatusText" Margin="0,0,16,0"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                           Text="スキャン完了後、登録する教材を確認してください" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButton}"
                            Click="OpenManualRegistration_Click" Content="1冊ずつ登録" />
                    <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButton}"
                            Click="Close_Click" Content="閉じる" />
                    <Button x:Name="RegisterSelectedButton" MinWidth="190"
                            Style="{StaticResource PrimaryButton}" Click="RegisterSelected_Click"
                            IsEnabled="False" Content="選択した教材をまとめて登録" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
