<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/report-excel-aliases.json" />
    <EmbeddedResource Include="Configuration/additional-excel-catalog.json" />
    <Content Include="Configuration/additional-excel-catalog.json"
             Link="additional-excel-catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Configuration/additional-stage-catalog.json" Condition="Exists('Configuration/additional-stage-catalog.json')" />
    <Content Include="Configuration/additional-stage-catalog.json" Condition="Exists('Configuration/additional-stage-catalog.json')"
             Link="additional-stage-catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Configuration\shared-material-catalog.json"
             Link="shared-material-catalog.json" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Configuration\shared-material-catalog.json"
                      LogicalName="AutomaticTestPrinting.Core.Configuration.shared-material-catalog.json" />
    <Content Include="Configuration\materials.json"
             Link="materials.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Configuration\materials.json"
                      LogicalName="AutomaticTestPrinting.Core.Configuration.materials.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
